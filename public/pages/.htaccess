# Seguridad: public/pages/ contiene SOLO recursos estáticos de la plantilla (CSS/JS/imágenes).
# La plantilla traía scripts PHP de demostración (subida y borrado de archivos, envío de correo)
# que cualquiera podía ejecutar, p. ej. pages/file-upload/file-upload.php permitía subir un .php
# y ejecutarlo en el servidor. La aplicación no usa ninguno: aquí se bloquea su ejecución.

<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>

RemoveHandler .php .phtml .phar .pht .phps .php3 .php4 .php5 .php7 .php8 .cgi .pl .py .sh
RemoveType .php .phtml .phar .pht .phps .php3 .php4 .php5 .php7 .php8

<FilesMatch "(?i)\.(php\d?|phtml|phar|pht|phps|cgi|pl|py|sh|asp|aspx|jsp|sql|lang|json)$">
    Require all denied
</FilesMatch>

<FilesMatch "^\.">
    Require all denied
</FilesMatch>
